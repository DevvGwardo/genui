        "rows": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/cell"
            }
          }
        }
      }
    },
    "bar_chart": {
      "type": "object",
      "required": [
        "type",
        "title",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "bar_chart"
        },
        "title": {
