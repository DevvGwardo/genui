{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DevvGwardo/genui/main/schema/v2.json",
  "title": "Hermes Desk render_ui payload (v2)",
  "description": "Strict v2 contract for bounded, data-only Generated UI cards (22 widget types: stat, table, bar_chart, checklist, line_chart, donut_chart, key_value, progress_list, timeline, alert, metric_grid, status_grid, funnel_chart, heatmap, diff_list, gauge, treemap, stacked_bar, radar_chart, log_stream, kanban, slo_burn). Selected via Uphill Catalog Evaluation while keeping schema/v1.json frozen.",
  "type": "object",
  "required": [
    "version",
    "components"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 2,
      "description": "Schema version. Only 2 is accepted by schema/v2.json."
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/stat"
          },
          {
            "$ref": "#/$defs/table"
          },
          {
            "$ref": "#/$defs/bar_chart"
          },
          {
            "$ref": "#/$defs/checklist"
          },
          {
            "$ref": "#/$defs/line_chart"
          },
          {
            "$ref": "#/$defs/donut_chart"
          },
          {
            "$ref": "#/$defs/key_value"
          },
          {
            "$ref": "#/$defs/progress_list"
          },
          {
            "$ref": "#/$defs/timeline"
          },
          {
            "$ref": "#/$defs/alert"
          },
          {
            "$ref": "#/$defs/metric_grid"
          },
          {
            "$ref": "#/$defs/status_grid"
          },
          {
            "$ref": "#/$defs/funnel_chart"
          },
          {
            "$ref": "#/$defs/heatmap"
          },
          {
            "$ref": "#/$defs/diff_list"
          },
          {
            "$ref": "#/$defs/gauge"
          },
          {
            "$ref": "#/$defs/treemap"
          },
          {
            "$ref": "#/$defs/stacked_bar"
          },
          {
            "$ref": "#/$defs/radar_chart"
          },
          {
            "$ref": "#/$defs/log_stream"
          },
          {
            "$ref": "#/$defs/kanban"
          },
          {
            "$ref": "#/$defs/slo_burn"
          }
        ]
      }
    }
  },
  "$comment": "Runtime-enforced rules mirrored by tools/validate-v2.py: (1) compact UTF-8 size <= 16,384 bytes (too_large); (2) table row width == columns.length; (3) checklist item ids unique within component; (4) line_chart series[].values.length == xLabels.length; (5) progress_list item max > 0; (6) astral-plane format characters rejected.",
  "$defs": {
    "plainText": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "not": {
        "anyOf": [
          {
            "pattern": "[<>]"
          },
          {
            "pattern": "//"
          },
          {
            "pattern": "(?:[hH][tT][tT][pP][sS]?|[fF][iI][lL][eE]|[dD][aA][tT][aA]|[jJ][aA][vV][aA][sS][cC][rR][iI][pP][tT]|[vV][bB][sS][cC][rR][iI][pP][tT]):"
          },
          {
            "pattern": "[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u180E\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF\\uFFF9-\\uFFFB]"
          }
        ]
      }
    },
    "text40": {
      "type": "string",
      "allOf": [
        {
          "$ref": "#/$defs/plainText"
        },
        {
          "maxLength": 40
        }
      ]
    },
    "text60": {
      "type": "string",
      "allOf": [
        {
          "$ref": "#/$defs/plainText"
        },
        {
          "maxLength": 60
        }
      ]
    },
    "text80": {
      "type": "string",
      "allOf": [
        {
          "$ref": "#/$defs/plainText"
        },
        {
          "maxLength": 80
        }
      ]
    },
    "text160": {
      "type": "string",
      "allOf": [
        {
          "$ref": "#/$defs/plainText"
        },
        {
          "maxLength": 160
        }
      ]
    },
    "tone": {
      "type": "string",
      "enum": [
        "neutral",
        "good",
        "warn",
        "bad"
      ]
    },
    "cell": {
      "anyOf": [
        {
          "$ref": "#/$defs/text160"
        },
        {
          "type": "number",
          "minimum": -1000000000000.0,
          "maximum": 1000000000000.0
        }
      ]
    },
    "stat": {
      "type": "object",
      "required": [
        "type",
        "title",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "stat"
        },
        "title": {
          "$ref": "#/$defs/text80"
        },
        "value": {
          "$ref": "#/$defs/text80"
        },
        "detail": {
          "$ref": "#/$defs/text160"
        },
        "tone": {
          "$ref": "#/$defs/tone"
        },
        "sparkline": {
          "type": "array",
          "minItems": 2,
          "maxItems": 24,
          "items": {
            "type": "number",
            "minimum": -1000000000000.0,
            "maximum": 1000000000000.0
          }
        }
      }
    },
    "table": {
      "type": "object",
      "required": [
        "type",
        "title",
        "columns",
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
